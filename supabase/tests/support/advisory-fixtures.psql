-- Synthetic rollback/disposable CI only. No provider request or hosted execution.
create function pg_temp.advisory_configuration() returns jsonb language sql immutable as $$
 select '{"enabled":true,"reviewerVisible":false,"noticeReference":"synthetic-notice-evidence","evaluationReference":"synthetic-evaluation-evidence","operatingReference":"synthetic-operating-evidence","model":"deepseek-flash","maxTokens":1200,"maxPerRun":2,"maxPerDay":20,"estimatedCostPerAbstract":0.5,"dailyCostCap":5,"currency":"USD","maxAttempts":2}'::jsonb;
$$;
create function pg_temp.advisory_id(n integer) returns uuid language sql immutable as $$
 select ('e8000000-0000-4000-8000-'||lpad(n::text,12,'0'))::uuid;
$$;
create function pg_temp.advisory_submission(n integer,edition text,actor integer,pi_email text default 'synthetic-pi@example.invalid') returns void language plpgsql as $$begin
 insert into msrc_abstracts.submissions(id,edition_key,actor_id,version,document,status,reference,word_count,finalized_at)
 values(pg_temp.advisory_id(n),edition,pg_temp.registration_actor(actor),1,pg_temp.abstract_document(pi_email),'scientific_review','SYNTHETIC-AI-'||n,msrc_abstracts.word_count(pg_temp.abstract_document(pi_email)->'body'),clock_timestamp());
 insert into msrc_abstracts.snapshots(submission_id,version,document,word_count,settings_version)
 values(pg_temp.advisory_id(n),1,pg_temp.abstract_document(pi_email),msrc_abstracts.word_count(pg_temp.abstract_document(pi_email)->'body'),1);
 insert into msrc_abstracts.authors(submission_id,submission_version,position,author_id,name,email,affiliations)
 select pg_temp.advisory_id(n),1,ordinality::integer,(a->>'id')::uuid,a->>'name',a->>'email',
 array(select jsonb_array_elements_text(a->'affiliations')) from jsonb_array_elements(pg_temp.abstract_document(pi_email)->'authors') with ordinality x(a,ordinality);
 insert into msrc_abstracts.packets(submission_id,submission_version,packet,prepared_by)
 values(pg_temp.advisory_id(n),1,pg_temp.abstract_packet(),pg_temp.registration_actor(actor));
end$$;
create function pg_temp.advisory_output() returns jsonb language sql stable security definer set search_path='' as $$
 select jsonb_build_object('scores',(select jsonb_agg(jsonb_build_object('criterionId',r->>'id','value',4,'rationale','Synthetic scientific rationale')) from jsonb_array_elements(msrc_abstracts.rubric_2027()) r),'model','deepseek-flash','promptVersion','staff-advisory-org069-v2','total',100,'gates',(select jsonb_agg(jsonb_build_object('gate',g,'observation','Synthetic scientific observation')) from generate_series(1,6) g));
$$;
