# Optional: public homepage/About previews still work with all three values blank.
# Hosted Supabase: copy to ignored .env.local, set TARGET=hosted, the project's
# HTTPS URL (https://<project-ref>.supabase.co), and its sb_publishable_... key.
# Docker is not required for a hosted connection. Run pnpm db:verify-hosted.
# Local synthetic tests: TARGET=local (also the default if blank), loopback HTTP
# URL and local publishable key. pnpm db:env creates a fresh local file safely;
# it refuses to overwrite an existing hosted or local .env.local.
# Never copy a secret/service-role key, database password or legacy JWT key here.
# NEXT_PUBLIC_ variables are bundled into the browser: they are not secret storage.
NEXT_PUBLIC_SUPABASE_TARGET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only component workshop access. Development already enables it.
# Set true only for a local production build or an access-protected staging preview.
# Production Vercel deployments always reject this override. Never NEXT_PUBLIC_.
DESIGN_PREVIEW_ENABLED=

# Local montage review only. Requires next dev and never works in a production
# build or Vercel deployment. Ignored .tools/media derivatives must exist locally.
# Does not approve media publication or enable any operational workflow.
LOCAL_MEDIA_PREVIEW_ENABLED=

# Local synthetic staff MFA/session lab only. Bind Next to 127.0.0.1.
# Set synthetic for /en/staff-security-preview and /ar/staff-security-preview.
# Every Vercel environment rejects it, even if mistakenly enabled.
# No hosted settings are required or used by this lab. Never NEXT_PUBLIC_.
MSRC_AUTH_PREVIEW=

# Contact only (ORG-028/029): server-only, Production Vercel only. Blank/off retains
# the closed form. Setting true requires reviewed hosted counters, all configuration,
# approved abuse/processing policy and a new deployment. Never NEXT_PUBLIC_.
# Enter actual credentials only in Vercel secret storage, never this example file.
CONTACT_DELIVERY_ENABLED=
RESEND_API_KEY=
CONTACT_SUPABASE_URL=
CONTACT_SUPABASE_SECRET_KEY=
# A stable 32-byte random secret encoded as 64 hexadecimal characters.
CONTACT_SECURITY_SECRET=
# Reviewable engineering defaults, pending organizer confirmation: 3 seconds;
# 3/hour and 10/day independently for each IP and normalized email.
CONTACT_MINIMUM_FILL_SECONDS=
CONTACT_IP_HOUR_LIMIT=
CONTACT_IP_DAY_LIMIT=
CONTACT_EMAIL_HOUR_LIMIT=
CONTACT_EMAIL_DAY_LIMIT=

# Authentication delivery/readiness remains closed, payment adapters mock-only.
# CONTACT_TEST_MODE is owned by the disposable test harness; never enable on Vercel.

# Participant accounts (BL-AUTH-02/03/04/06/08): server-only and closed by default.
# Approval of EN/AR Privacy, reviewed migrations, native Auth guards/settings and
# a shared-provider email budget are separate release gates. Never NEXT_PUBLIC_.
# Set actual credentials in Production secret storage, never this example file.
PARTICIPANT_ACCOUNTS_ENABLED=
PARTICIPANT_AUTH_SECURITY_SECRET=
PARTICIPANT_SUPABASE_URL=
PARTICIPANT_SUPABASE_PUBLISHABLE_KEY=
PARTICIPANT_SUPABASE_SECRET_KEY=
PARTICIPANT_AUTH_EMAIL_DAILY_LIMIT=
PARTICIPANT_EDITION_KEY=
# RESEND_API_KEY above is shared with Contact. Account emails draw from the same quota.
# PARTICIPANT_ACCOUNTS_TEST_MODE belongs only to the fixed loopback test harness.

# Staff portal (BL-AUTH-01/05/06, BL-RPT-01/03): closed by default; server-only.
# Reviewed migrations, mutual Super Admin recovery, provider budget and UAT must
# pass before separately authorized Production activation. Never NEXT_PUBLIC_.
STAFF_PORTAL_ENABLED=
# Authenticated owner password change: independently closed until its additive
# migration, exact-head native tests and release checks pass. Never NEXT_PUBLIC_.
STAFF_PASSWORD_CHANGE_ENABLED=false
STAFF_AUTH_SECURITY_SECRET=
STAFF_SUPABASE_URL=
STAFF_SUPABASE_PUBLISHABLE_KEY=
STAFF_SUPABASE_SECRET_KEY=
STAFF_AUTH_EMAIL_DAILY_LIMIT=
STAFF_EDITION_KEY=
# RESEND_API_KEY is shared above. Invitation + regular staff code sends share its quota.
# STAFF_PORTAL_TEST_MODE belongs only to the fixed synthetic loopback harness.

# Advisory assessment (BL-AI-01, AI-01..06): server-only, disabled by default.
# The flag and key are insufficient: version-bound scientific/privacy approvals,
# approved rubric, authority, audit and atomic budget controls are also required.
# No application route/worker is connected in this foundation. Never NEXT_PUBLIC_.
# Enter a real key only in approved secret storage, never in this example file.
AI_ASSESSMENT_ENABLED=
ANTHROPIC_API_KEY=
# Local synthetic evaluation uses a separate AI_SYNTHETIC_API_KEY supplied to
# the explicit CLI only; it refuses CI/Vercel and accepts no real abstracts.
