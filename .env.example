# Optional: the public placeholder requires NO environment variables.
# For the LOCAL synthetic database only, copy this file to .env.local.
# Run pnpm db:start then obtain the local URL and publishable key using pnpm db:status.
# Do not paste a secret/service-role key here. Never use a remote project in M1.
# NEXT_PUBLIC_ variables are bundled into the browser: they are not secret storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# There are no production credentials, email providers, payment endpoints,
# privileged keys, operational enable flags or real-recipient settings in M1.
# Email is console/test-only and payments mock-only when their later slices exist.
