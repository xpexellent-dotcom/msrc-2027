# Optional: public homepage/About previews still work with all three values blank.
# Hosted Supabase: copy to ignored .env.local, set TARGET=hosted, the project's
# HTTPS URL (https://<project-ref>.supabase.co), and its sb_publishable_... key.
# Docker is not required for a hosted connection. Run pnpm db:verify-hosted.
# Local synthetic tests: TARGET=local (also the default if blank), loopback HTTP
# URL and local publishable key. pnpm db:env creates a fresh local file safely;
# it refuses to overwrite an existing hosted or local .env.local.
# Never copy a secret/service-role key, database password or legacy JWT key here.
# NEXT_PUBLIC_ variables are bundled into the browser: they are not secret storage.
NEXT_PUBLIC_SUPABASE_TARGET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only component workshop access. Development already enables it.
# Set true only for a local production build or an access-protected staging preview.
# Production Vercel deployments always reject this override. Never NEXT_PUBLIC_.
DESIGN_PREVIEW_ENABLED=

# There are no email providers, payment endpoints, privileged keys,
# operational enable flags or real-recipient settings in this foundation.
# Email is console/test-only and payments mock-only when their later slices exist.
