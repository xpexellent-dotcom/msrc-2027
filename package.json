{
  "name": "msrc-2027",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:start": "supabase start --network-id msrc2027-local",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:env": "node scripts/write-local-env.mjs",
    "db:reset": "supabase db reset --local --yes --network-id msrc2027-local",
    "db:test": "supabase test db --local --network-id msrc2027-local",
    "db:integration": "vitest run --config vitest.integration.config.ts",
    "db:verify-hosted": "node --env-file-if-exists=.env.local scripts/verify-hosted-supabase.mjs",
    "db:verify-authorization-hosted": "node --env-file-if-exists=.env.local scripts/verify-hosted-authorization.mjs",
    "db:lint": "supabase db lint --local --schema public,msrc_authorization --level warning --fail-on warning",
    "db:types": "supabase gen types --local --schema public"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "client-only": "0.0.1",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "supabase": "2.118.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
