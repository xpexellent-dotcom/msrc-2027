exports[`DRAFT bilingual registration email templates > renders complete English and Arabic with the banner for registration_confirm_seat 1`] = `
{
  "from": "MSRC 2027 <no-reply@msrc2027.com>",
  "html": "<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>MSRC 2027</title></head><body style="margin:0;background-color:#f5f3f7;color:#211a2d;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.7"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td align="center"><table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:600px;background-color:#ffffff"><tr><td><img src="https://www.msrc2027.com/brand/email-banner.png" alt="MSRC 2026 conference audience — previous edition" width="600" height="338" style="display:block;width:100%;max-width:600px;height:auto;border:0"></td></tr><tr><td style="padding:28px 24px"><div dir="ltr" lang="en"><p style="margin:0 0 20px;white-space:pre-wrap;overflow-wrap:anywhere">The 5th Medical Students Research Conference</p><p style="margin:0 0 20px;white-space:pre-wrap;overflow-wrap:anywhere">Conference dates: 27–28 January 2027.</p><p style="margin:0 0 20px;white-space:pre-wrap;overflow-wrap:anywhere">Please confirm that you can attend on My registration. If you cannot attend, you can release your seat there.</p><p style="margin:0 0 20px;white-space:pre-wrap;overflow-wrap:anywhere">Confirmation deadline: 24 January 2027 at 20:00 (Asia/Riyadh).</p><p style="margin:0 0 20px;white-space:pre-wrap;overflow-wrap:anywhere">If you do not respond by this deadline, your seat will be released and your ticket will no longer be valid.</p><p style="margin:0 0 20px;white-space:pre-wrap;overflow-wrap:anywhere">Sign in to My registration: <a dir="ltr" href="https://www.msrc2027.com/en/registration" style="color:#563681;overflow-wrap:anywhere">https://www.msrc2027.com/en/registration</a></p><p style="margin:0 0 20px;white-space:pre-wrap;overflow-wrap:anywhere">Support: contact@msrc2027.com</p></div><hr style="border:0;border-top:1px solid #d9d2e1;margin:28px 0"><div dir="rtl" lang="ar" style="font-family:'Noto Sans Arabic',Tahoma,Arial,sans-serif;text-align:right"><p style="margin:0 0 20px;white-space:pre-wrap;overflow-wrap:anywhere">المؤتمر الخامس لأبحاث طلاب الطب</p><p style="margin:0 0 20px;white-space:pre-wrap;overflow-wrap:anywhere">موعد المؤتمر: ٢٧–٢٨ يناير ٢٠٢٧.</p><p style="margin:0 0 20px;white-space:pre-wrap;overflow-wrap:anywhere">يُرجى تأكيد قدرتك على الحضور من صفحة تسجيلي. إذا تعذّر عليك الحضور، فيمكنك إتاحة مقعدك لغيرك من الصفحة نفسها.</p><p style="margin:0 0 20px;white-space:pre-wrap;overflow-wrap:anywhere">الموعد النهائي للتأكيد: ٢٤ يناير ٢٠٢٧ في ٢٠:٠٠ (بتوقيت الرياض).</p><p style="margin:0 0 20px;white-space:pre-wrap;overflow-wrap:anywhere">إذا لم ترد بحلول هذا الموعد، فسيُتاح مقعدك لغيرك ولن تعود تذكرتك صالحة.</p><p style="margin:0 0 20px;white-space:pre-wrap;overflow-wrap:anywhere">سجّل الدخول إلى صفحة تسجيلي: <a dir="ltr" href="https://www.msrc2027.com/ar/registration" style="color:#563681;overflow-wrap:anywhere">https://www.msrc2027.com/ar/registration</a></p><p style="margin:0 0 20px;white-space:pre-wrap;overflow-wrap:anywhere">للدعم: contact@msrc2027.com</p></div></td></tr></table></td></tr></table></body></html>",
  "subject": "Please confirm your seat by 24 January 2027 at 20:00 (Asia/Riyadh) | يُرجى تأكيد مقعدك بحلول ٢٤ يناير ٢٠٢٧ في ٢٠:٠٠ (بتوقيت الرياض)",
  "text": "MSRC 2026 conference audience — previous edition: https://www.msrc2027.com/brand/email-banner.png

The 5th Medical Students Research Conference

Conference dates: 27–28 January 2027.

Please confirm that you can attend on My registration. If you cannot attend, you can release your seat there.

Confirmation deadline: 24 January 2027 at 20:00 (Asia/Riyadh).

If you do not respond by this deadline, your seat will be released and your ticket will no longer be valid.

Sign in to My registration: https://www.msrc2027.com/en/registration

Support: contact@msrc2027.com

---

المؤتمر الخامس لأبحاث طلاب الطب

موعد المؤتمر: ٢٧–٢٨ يناير ٢٠٢٧.

يُرجى تأكيد قدرتك على الحضور من صفحة تسجيلي. إذا تعذّر عليك الحضور، فيمكنك إتاحة مقعدك لغيرك من الصفحة نفسها.

الموعد النهائي للتأكيد: ٢٤ يناير ٢٠٢٧ في ٢٠:٠٠ (بتوقيت الرياض).

إذا لم ترد بحلول هذا الموعد، فسيُتاح مقعدك لغيرك ولن تعود تذكرتك صالحة.

سجّل الدخول إلى صفحة تسجيلي: https://www.msrc2027.com/ar/registration

للدعم: contact@msrc2027.com",
  "to": [
    "participant@example.invalid",
  ],
}
`;

